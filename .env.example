# ===== Model =====
CONFIG_VERSION=1
APP_ENV=development
ARK_API_KEY=your_ark_api_key
MODEL=your_model_name
# 复杂度规划，以及 Step-back / HyDE 单选重写使用低延迟模型。
FAST_MODEL=your_fast_model_name
# 证据相关性、可回答性、歧义和路由评判使用独立的高能力模型。
GRADE_MODEL=your_grade_model_name
BASE_URL=https://your-llm-endpoint/v1
# Answer model 原生请求超时；SDK 内建重试固定关闭，由 Provider policy 唯一负责重试。
MODEL_TIMEOUT_SECONDS=30
# Planner / Grader / Rewrite 单次阶段 deadline；仍受 RUN_DEADLINE_SECONDS 上限约束。
RAG_MODEL_TIMEOUT_SECONDS=15

# ===== 本地稠密向量（langchain_huggingface，默认 BAAI/bge-m3）=====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DEVICE=cpu
DENSE_EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=15
# Query encoding 由专用 Provider loop 微批处理；本地模型默认串行，基准验证后再放大。
EMBEDDING_EXECUTOR_WORKERS=1
EMBEDDING_MAX_CONCURRENCY=1
EMBEDDING_QUERY_MICROBATCH_MS=20
EMBEDDING_QUERY_MAX_BATCH_SIZE=16
EMBEDDING_QUERY_QUEUE_SIZE=128
EMBEDDING_QUERY_CACHE_SIZE=1024
EMBEDDING_CACHE_NAMESPACE=default
EMBEDDING_WARMUP_ON_START=true
# Hugging Face 国内镜像源加速（解决直连 huggingface.co 加载本地嵌入模型卡死的问题）
HF_ENDPOINT=https://hf-mirror.com

# ===== Rerank (可选，不配则自动降级) =====
RERANK_MODEL=your_rerank_model
RERANK_BINDING_HOST=https://your-rerank-host
RERANK_API_KEY=your_rerank_api_key
# Rerank 上游最大等待时间；占位符配置会被自动识别为未启用。
RERANK_TIMEOUT_SECONDS=5
RERANK_MAX_CONCURRENCY=4
RERANK_MAX_CONNECTIONS=20
RERANK_MAX_KEEPALIVE_CONNECTIONS=10
RERANK_CANDIDATE_LIMIT=30
RERANK_MAX_DOCUMENT_CHARACTERS=8000
RERANK_MAX_TOTAL_CHARACTERS=60000
RERANK_CIRCUIT_FAILURE_THRESHOLD=5
RERANK_CIRCUIT_RESET_SECONDS=30

# ===== 检索候选池 & Auto-merging =====
# 精排后返回给 Agent 的片段数
RETRIEVAL_TOP_K=8
# Milvus 叶子层召回候选数：设 RETRIEVAL_CANDIDATE_K 时优先使用（且 >= top_k）
# 未设 K 时：candidate_k = max(top_k * RETRIEVAL_CANDIDATE_MULTIPLIER, top_k)
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_CANDIDATE_MULTIPLIER=3
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3
# 精排后进入 Agent 的最低分（默认 0，上线后按数据标定）
RERANK_MIN_SCORE=0.0

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_collection
# 单次 RPC 超时（秒）；连接按请求创建，不长期占用 gRPC channel
MILVUS_TIMEOUT=30
# RAG 向量检索阶段 deadline；不能越过 Run 总 deadline。
VECTOR_TIMEOUT_SECONDS=10

# ===== Database / Cache =====
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/langchain_app
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=supermew

# ===== Run / Event =====
RUN_DEADLINE_SECONDS=120
RUN_EVENT_QUEUE_SIZE=256
RUN_HEARTBEAT_SECONDS=15
RUN_ON_DISCONNECT=continue
RUN_MULTITASK_STRATEGY=reject
RUN_EVENT_POLL_INTERVAL_SECONDS=0.25
RUN_EVENT_STREAM_MAXLEN=10000
OUTBOX_BATCH_SIZE=100
RUN_CANCELLATION_TTL_SECONDS=3600
RUN_CANCELLATION_WAIT_SECONDS=0.2

# ===== Agent Harness =====
AGENT_RECURSION_LIMIT=32
AGENT_MAX_MODEL_CALLS=4
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_REPEATED_TOOL_CALLS=2
AGENT_MAX_CONTEXT_TOKENS=12000
AGENT_RESPONSE_RESERVE_TOKENS=2048
AGENT_MEMORY_MESSAGE_THRESHOLD=6

# ===== Auth =====
JWT_SECRET_KEY=replace-with-strong-random-secret
ADMIN_INVITE_CODE=supermew-admin-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14
PASSWORD_PBKDF2_ROUNDS=310000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# ===== Upload / Worker =====
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_PAGES=2000
MAX_PAGE_CHARACTERS=200000
PARSER_TIMEOUT_SECONDS=120
MAX_ARCHIVE_ENTRIES=5000
MAX_UNCOMPRESSED_BYTES=262144000
MAX_COMPRESSION_RATIO=100
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_ATTEMPTS=3
RUN_WORKER_MAX_CONCURRENCY=8

# ===== Observability / Skills =====
LOG_LEVEL=INFO
METRICS_ENABLED=true
TRACE_RETENTION_DAYS=30
SANDBOX_ENABLED=false

# ===== Tools（可选）=====
AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_API_KEY=your_amap_api_key
