# ===== Model =====
CONFIG_VERSION=1
APP_ENV=development
ARK_API_KEY=your_ark_api_key
MODEL=your_model_name
# 复杂度规划，以及 Step-back / HyDE 单选重写使用低延迟模型。
FAST_MODEL=your_fast_model_name
# 证据相关性、可回答性、歧义和路由评判使用独立的高能力模型。
GRADE_MODEL=your_grade_model_name
BASE_URL=https://your-llm-endpoint/v1
# Answer model 原生请求超时；SDK 内建重试固定关闭，由 Provider policy 唯一负责重试。
MODEL_TIMEOUT_SECONDS=30
# Planner / Grader / Rewrite 单次阶段 deadline；仍受 RUN_DEADLINE_SECONDS 上限约束。
RAG_MODEL_TIMEOUT_SECONDS=15

# ===== 本地稠密向量（langchain_huggingface，默认 BAAI/bge-m3）=====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DEVICE=cpu
DENSE_EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=15
# Query encoding 由专用 Provider loop 微批处理；本地模型默认串行，基准验证后再放大。
EMBEDDING_EXECUTOR_WORKERS=1
EMBEDDING_MAX_CONCURRENCY=1
EMBEDDING_QUERY_MICROBATCH_MS=20
EMBEDDING_QUERY_MAX_BATCH_SIZE=16
EMBEDDING_QUERY_QUEUE_SIZE=128
EMBEDDING_QUERY_CACHE_SIZE=1024
EMBEDDING_CACHE_NAMESPACE=default
EMBEDDING_WARMUP_ON_START=true
# Hugging Face 国内镜像源加速（解决直连 huggingface.co 加载本地嵌入模型卡死的问题）
HF_ENDPOINT=https://hf-mirror.com

# ===== Rerank (可选，不配则自动降级) =====
RERANK_MODEL=your_rerank_model
RERANK_BINDING_HOST=https://your-rerank-host
RERANK_API_KEY=your_rerank_api_key
# Rerank 上游最大等待时间；占位符配置会被自动识别为未启用。
RERANK_TIMEOUT_SECONDS=5
RERANK_MAX_CONCURRENCY=4
RERANK_MAX_CONNECTIONS=20
RERANK_MAX_KEEPALIVE_CONNECTIONS=10
RERANK_CANDIDATE_LIMIT=30
RERANK_MAX_DOCUMENT_CHARACTERS=8000
RERANK_MAX_TOTAL_CHARACTERS=60000
RERANK_CIRCUIT_FAILURE_THRESHOLD=5
RERANK_CIRCUIT_RESET_SECONDS=30

# ===== 检索候选池 & Auto-merging =====
# 精排后返回给 Agent 的片段数
RETRIEVAL_TOP_K=8
# Milvus 叶子层召回候选数：设 RETRIEVAL_CANDIDATE_K 时优先使用（且 >= top_k）
# 未设 K 时：candidate_k = max(top_k * RETRIEVAL_CANDIDATE_MULTIPLIER, top_k)
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_CANDIDATE_MULTIPLIER=3
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3
# 精排后进入 Agent 的最低分（默认 0，上线后按数据标定）
RERANK_MIN_SCORE=0.0

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_collection
# 单次 RPC 超时（秒）；连接按请求创建，不长期占用 gRPC channel
MILVUS_TIMEOUT=30
# RAG 向量检索阶段 deadline；不能越过 Run 总 deadline。
VECTOR_TIMEOUT_SECONDS=10

# ===== Database / Cache =====
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/langchain_app
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=supermew

# ===== Read-only SQL Assistant（默认关闭）=====
# 必须使用独立的 PostgreSQL 登录角色；该角色不能是 relation owner，也不能拥有写入、
# CREATE、TEMP、BYPASSRLS 或高权限角色成员资格；allowlist table 必须启用 RLS。
# DSN、原始 SQL 与 literal 不会写入 prompt、checkpoint、事件或审计。
SQL_ASSISTANT_ENABLED=false
SQL_ASSISTANT_DSN=
SQL_ASSISTANT_EXPECTED_ROLE=supermew_sql_reader
# schema 使用逗号分隔；table 必须写为 schema.table，也可显式配置 schema.*。
SQL_ASSISTANT_ALLOWED_SCHEMAS=analytics
SQL_ASSISTANT_ALLOWED_TABLES=analytics.orders,analytics.customers
# 敏感列写为 schema.table.column；返回前统一掩码，模型不能绕过。
SQL_ASSISTANT_SENSITIVE_COLUMNS=analytics.customers.email
SQL_ASSISTANT_CONNECT_TIMEOUT_SECONDS=5
SQL_ASSISTANT_SCHEMA_TIMEOUT_SECONDS=5
SQL_ASSISTANT_STATEMENT_TIMEOUT_SECONDS=10
SQL_ASSISTANT_LOCK_TIMEOUT_SECONDS=1
SQL_ASSISTANT_MAX_ROWS=200
SQL_ASSISTANT_MAX_RESULT_BYTES=262144
SQL_ASSISTANT_MAX_CELL_BYTES=65536
SQL_ASSISTANT_MAX_ESTIMATED_COST=100000
SQL_ASSISTANT_MAX_ESTIMATED_ROWS=100000
SQL_ASSISTANT_MAX_ESTIMATED_BYTES=8388608
SQL_ASSISTANT_FETCH_SIZE=64
SQL_ASSISTANT_POOL_MIN_SIZE=1
SQL_ASSISTANT_POOL_MAX_SIZE=4
SQL_ASSISTANT_POOL_TIMEOUT_SECONDS=5
SQL_ASSISTANT_POOL_MAX_LIFETIME_SECONDS=1800
SQL_ASSISTANT_CATALOG_CACHE_TTL_SECONDS=300
SQL_ASSISTANT_MAX_SQL_CHARACTERS=20000
SQL_ASSISTANT_MAX_TABLES_PER_QUERY=8
SQL_ASSISTANT_MAX_AST_NODES=1000
SQL_ASSISTANT_STRICT_PRIVILEGE_CHECK=true

# ===== Web Research + 引用（默认关闭）=====
# Brave Search key 只由进程级 Runtime 持有；Secret 值不会进入 prompt、Run state、
# checkpoint、Event 或 ToolAudit。搜索端点固定为 Brave 官方 HTTPS origin，不可配置。
WEB_RESEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=
# 每个请求及 DNS 查询均受 Run deadline/cancellation 的更小边界约束。
WEB_RESEARCH_REQUEST_TIMEOUT_SECONDS=10
WEB_RESEARCH_DNS_TIMEOUT_SECONDS=2
WEB_RESEARCH_DNS_MAX_CONCURRENCY=4
# 单次 DNS snapshot 最多接受的全部 global 地址；硬上限为 32。
WEB_RESEARCH_MAX_DNS_ADDRESSES=8
WEB_RESEARCH_MAX_QUERY_BYTES=4096
WEB_RESEARCH_MAX_URL_BYTES=4096
WEB_RESEARCH_DEFAULT_SEARCH_RESULTS=5
WEB_RESEARCH_MAX_SEARCH_RESULTS=12
WEB_RESEARCH_MAX_CITATIONS=32
WEB_RESEARCH_MAX_REDIRECTS=5
# 同时作为 Tool descriptor 上限与共享 Web Runtime 并发上限。
WEB_RESEARCH_MAX_CONCURRENCY=4
# 压缩传输体、解压响应、单页正文与一次结果分别独立限流。
# 证据结果默认只占 Agent 输入预算的少数部分；启动校验强制其不超过一半。
WEB_RESEARCH_MAX_COMPRESSED_BYTES=1000000
WEB_RESEARCH_MAX_RESPONSE_BYTES=2097152
WEB_RESEARCH_MAX_TITLE_BYTES=512
WEB_RESEARCH_MAX_SNIPPET_BYTES=1024
WEB_RESEARCH_MAX_CONTENT_BYTES=3072
WEB_RESEARCH_MAX_TOTAL_EVIDENCE_BYTES=4096
WEB_RESEARCH_USER_AGENT=SuperMew-WebResearch/1.0

# ===== Run / Event =====
RUN_DEADLINE_SECONDS=120
RUN_EVENT_QUEUE_SIZE=256
RUN_HEARTBEAT_SECONDS=15
RUN_ON_DISCONNECT=continue
RUN_MULTITASK_STRATEGY=reject
RUN_EVENT_POLL_INTERVAL_SECONDS=0.25
RUN_EVENT_STREAM_MAXLEN=10000
OUTBOX_BATCH_SIZE=100
RUN_CANCELLATION_TTL_SECONDS=3600
RUN_CANCELLATION_WAIT_SECONDS=0.2

# ===== Agent Harness =====
AGENT_RECURSION_LIMIT=32
AGENT_MAX_MODEL_CALLS=4
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_REPEATED_TOOL_CALLS=2
AGENT_MAX_CONTEXT_TOKENS=12000
AGENT_RESPONSE_RESERVE_TOKENS=2048
AGENT_MEMORY_MESSAGE_THRESHOLD=6

# ===== Auth =====
JWT_SECRET_KEY=replace-with-strong-random-secret
ADMIN_INVITE_CODE=supermew-admin-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14
PASSWORD_PBKDF2_ROUNDS=310000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# ===== Upload / Worker =====
UPLOAD_DIR=./data/documents
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_PAGES=2000
MAX_PAGE_CHARACTERS=200000
PARSER_TIMEOUT_SECONDS=120
MAX_ARCHIVE_ENTRIES=5000
MAX_UNCOMPRESSED_BYTES=262144000
MAX_COMPRESSION_RATIO=100
DEFAULT_TENANT_ID=default
DEFAULT_KNOWLEDGE_BASE_NAME=默认知识库
DOCUMENT_PARSER_VERSION=document-loader-v2
DOCUMENT_CHUNKER_VERSION=three-level-800-100-v2
DOCUMENT_INDEX_VERSION=catalog-v1
DOCUMENT_INDEX_CLEANUP_GRACE_SECONDS=3600
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_ATTEMPTS=3
RUN_WORKER_MAX_CONCURRENCY=8
INDEX_WORKER_ID=
INDEX_WORKER_REQUIRED=true
INDEX_WORKER_POLL_SECONDS=1
INDEX_WORKER_LEASE_SECONDS=90
INDEX_WORKER_HEARTBEAT_SECONDS=15
INDEX_WORKER_RETRY_BASE_SECONDS=5
INDEX_WORKER_RETRY_MAX_SECONDS=300
INDEX_WORKER_RETRY_JITTER_RATIO=0.2
INDEX_WORKER_READINESS_TTL_SECONDS=45

# ===== Observability / Skills =====
LOG_LEVEL=INFO
METRICS_ENABLED=true
TRACE_RETENTION_DAYS=30
SKILL_DIR=./skills
SKILL_MANIFEST_NAME=skill.yaml
SKILL_MAX_CONTENT_BYTES=262144

# ===== Isolated Sandbox（默认关闭）=====
SANDBOX_ENABLED=false
SANDBOX_ADAPTER=docker
# 必须是本地已有的不可变 digest，例如 registry/image@sha256:<64 hex>；启动不会 pull。
SANDBOX_DOCKER_IMAGE=
SANDBOX_DOCKER_BINARY=docker
# 只接受本地 unix:// endpoint。生产必须 require rootless，并建议使用专用 daemon；
# Docker socket 只供可信宿主进程使用，绝不能挂入不可信 Sandbox 容器。
SANDBOX_DOCKER_HOST=
SANDBOX_REQUIRE_ROOTLESS=false
# Sandbox 无网络、无 bind mount、无持久 artifact；workspace 是有硬上限的 tmpfs。
# enabled 后 daemon/image 不 ready 会阻止 /health/ready；disabled 不会探测 Docker。
SANDBOX_MAX_CONCURRENCY=2
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_BYTES=268435456
SANDBOX_PIDS_LIMIT=32
SANDBOX_WORKSPACE_BYTES=67108864
SANDBOX_MAX_SOURCE_BYTES=65536
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_MAX_FILES=32
SANDBOX_MAX_FILE_BYTES=8388608
SANDBOX_MAX_TOTAL_FILE_BYTES=33554432
SANDBOX_MAX_PATH_BYTES=240
SANDBOX_MAX_PATH_DEPTH=8
SANDBOX_CLEANUP_TIMEOUT_SECONDS=3

# ===== Tools（可选）=====
AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_API_KEY=your_amap_api_key
